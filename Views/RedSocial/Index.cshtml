
<section>
    <form method="post" action = '@Url.Action("IniciarSesion", "RedSocial")' onsubmit="return validarLogin()">
    <h1>Iniciar Sesión</h1>
        <br>Nombre de Usuario:<br>
        <input type="text" id="nombreUsuario" placeholder="TuNombre" name="nombreUsuario"><br>
        <br>Contraseña:<br>
        <input type="password" id="contrasena" placeholder="********" name="contraseña"><br>
        <br><input type="submit" value="Iniciar Sesión"><br>
        <br><input type="reset" value="Resetear">
    </form>
    <p id="fb-login" class="feedback"></p>
    </section>
<p>¿No tienes cuenta? Registrate <a href="@Url.Action("Registrarse", "RedSocial")">acá</a></p>
<script src="/js/login.js"></script>